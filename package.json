{
  "name": "shopping-peace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Just-in-time stock calculator for household items: when to fetch more, how much to fetch, how much to keep.",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:catalogue": "node scripts/build-emoji-catalogue.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:properties": "FC_RUNS=1000 vitest run tests/stock-plan.properties.test.ts tests/presets-file.properties.test.ts",
    "test:e2e": "playwright test",
    "coverage": "vitest run --coverage",
    "coverage:all": "node scripts/coverage-report.mjs",
    "crap": "node scripts/crap-report.mjs",
    "duplicates": "jscpd src tests",
    "mutation": "stryker run",
    "gate": "./quality-gate.sh",
    "gate:full": "./quality-gate.sh --full",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "daisyui": "^5.7.50",
    "emojilib": "^4.0.3",
    "fast-check": "^4.10.2",
    "jscpd": "^5.4.2",
    "jsdom": "^31.0.0",
    "oxlint": "^1.92.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "fsevents": true
  }
}
